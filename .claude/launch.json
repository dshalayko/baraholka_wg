{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "webserver",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "webserver"],
      "port": 8001
    },
    {
      "name": "debug-miniapp",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["run_debug.py"],
      "port": 8002,
      "autoPort": true
    },
    {
      "name": "webserver-preview",
      "runtimeExecutable": ".venv/bin/python",
      "runtimeArgs": ["-m", "uvicorn", "webserver.app:app", "--host", "127.0.0.1", "--port", "8011"],
      "port": 8011
    }
  ]
}
